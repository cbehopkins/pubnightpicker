{
    "name": "pubnightpicker-e2e-tests",
    "version": "1.0.0",
    "description": "Cucumber and Playwright browser journeys for PubNightPicker",
    "type": "module",
    "scripts": {
        "install:browsers": "playwright install chromium",
        "postinstall": "npm run install:browsers",
        "test": "npm run test:journey",
        "cucumber": "cucumber-js",
        "test:journey": "python run_gherkin_e2e.py",
        "test:journey:frontend": "python run_gherkin_e2e.py --group frontend",
        "test:journey:last-orders": "python run_gherkin_e2e.py --group last-orders",
        "test:harness": "python -m unittest discover -s . -p test_run_gherkin_e2e.py",
        "test:support": "node --test support.test.js"
    },
    "dependencies": {
        "firebase": "^10.0.0"
    },
    "devDependencies": {
        "@cucumber/cucumber": "^12.2.0",
        "playwright": "^1.56.1"
    },
    "engines": {
        "node": ">=20.0.0"
    }
}
