{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "pubnightpicker/firestore/polls",
    "title": "polls/{pollId}",
    "type": "object",
    "x-schemaVersion": 1,
    "required": [
        "date",
        "completed"
    ],
    "properties": {
        "createdByUid": {
            "type": "string",
            "minLength": 1,
            "description": "Authenticated human creator; immutable after creation. Absent on legacy or automatically created polls."
        },
        "completedByUid": {
            "type": "string",
            "minLength": 1,
            "description": "Authenticated human completing the initial selection. Cleared on rescheduling or automatic completion."
        },
        "date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "completed": {
            "type": "boolean"
        },
        "selected": {
            "type": "string",
            "minLength": 1
        },
        "restaurant": {
            "type": [
                "string",
                "null"
            ]
        },
        "restaurant_time": {
            "type": "string",
            "pattern": "^[0-2][0-9]:[0-5][0-9]$"
        },
        "previous_pubs": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "pubs": {
            "type": "object",
            "propertyNames": {
                "type": "string"
            },
            "additionalProperties": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    }
                },
                "additionalProperties": true
            }
        }
    },
    "additionalProperties": true
}
